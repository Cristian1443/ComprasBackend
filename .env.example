# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compras_db_qa
DB_USER=compras_app_qa
DB_PASSWORD=tu-password-aqui

# Puerto del servidor
API_PORT=3001

# URL del frontend (para CORS y emails)
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_RPM=60

# No confiar en X-Forwarded-For salvo que haya un proxy/balanceador real y
# confiable delante del backend. Deja "false" si no estás seguro — así la
# IP registrada en auditoría es la del socket, no una que el cliente pueda
# falsificar con ese header. Si sí hay un proxy delante, pon el número de
# saltos (normalmente "1") o "true".
TRUST_PROXY=false

# Azure AD — esta misma app registration se usa para DOS cosas:
#  1) app-only (client credentials): SharePoint y envío de correo vía Graph.
#  2) audience/issuer para validar el ID token que el frontend (SPA, mismo
#     Client ID que VITE_AZURE_CLIENT_ID) ya obtiene al iniciar sesión —
#     ver middleware/auth.js. No se necesita configurar nada nuevo en el
#     Portal de Azure para esto.
AZURE_TENANT_ID=tu-tenant-id-aqui
AZURE_CLIENT_ID=tu-client-id-aqui
AZURE_CLIENT_SECRET=tu-client-secret-aqui

# Buzón desde el que se envían los correos a proponentes vía Microsoft Graph.
# Requiere que el App Registration de arriba tenga el permiso de aplicación
# Mail.Send concedido con consentimiento de administrador en Azure AD.
GRAPH_MAIL_SENDER=correo-remitente@investinbogota.org

# SMTP (respaldo si no se usa Microsoft Graph)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@investinbogota.org
# SMTP_PASS=tu-password-aqui
